node_modules
dist/
.env
# Backups and per-environment variants. A `git add -A` staged a .env.bak-* here
# once; this repo is public, so the pattern is what stops it, not vigilance.
.env.*
# Credential-shaped files. Nothing of this shape is tracked in any weirdapps
# repo today, and these two lines are what keeps it that way: a stray
# `cp ~/keys/whatever.pem .` is otherwise one `git add -A` away from a commit,
# and on a private repo nothing server-side would catch it. A global ignore is
# not a substitute, because no clone and no CI runner ever reads one.
*.pem
*.key

!.env.example
*.session
*.session.txt
coverage/
*.log
.DS_Store

# Generated launchd plist (template lives at .plist.template; user-installed
# copy with substituted paths is local-only).
bridge/launchd/com.*.telegram-claude-bridge.plist
