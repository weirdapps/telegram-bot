# Telegram User Client — configuration template
#
# Copy this file to `.env` in the project root and fill in real values.
# Every required variable below MUST be set. The application throws a
# ConfigError at startup on any missing value — there are NO fallbacks.

# MTProto application ID (positive integer). Obtain at https://my.telegram.org → "API development tools".
TELEGRAM_API_ID=123456

# MTProto application hash (32-char hex). Obtain on the same page as TELEGRAM_API_ID. Treat as a secret.
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Your own Telegram phone number in international format (with leading +).
TELEGRAM_PHONE_NUMBER=+306900000000

# Absolute filesystem path where the serialized GramJS StringSession is persisted after login.
# The file is equivalent to a password. Keep it on a path with mode 0600.
TELEGRAM_SESSION_PATH=/Users/me/.telegram/session.txt

# Absolute directory where incoming photo / voice / audio attachments are saved.
# Auto-created on startup if it does not exist.
TELEGRAM_DOWNLOAD_DIR=/Users/me/.telegram/downloads

# pino log level. One of: trace | debug | info | warn | error | silent
TELEGRAM_LOG_LEVEL=info

# OPTIONAL: 2FA password. When set, `telegram-cli login` uses it instead of
# prompting, which enables unattended login but stores your 2FA password in a
# file. Leave it unset to be prompted interactively.
# TELEGRAM_2FA_PASSWORD=

# --- Bot API channel (optional) ---
# When set, the bridge ALSO listens for DMs to your bot. Get the token from
# BotFather (@BotFather on Telegram → /newbot or /token).
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# Override the default voice download dir ($HOME/.telegram/bot-inbox)
# TELEGRAM_BRIDGE_BOT_TMPDIR=/tmp/bot-inbox

# --- Bot-only mode (optional) ---
# Set to "true" to disable the MTProto Saved Messages channel and run as
# bot-only (DMs to your bot are the sole input). Useful when you don't want
# the bridge logged into your personal Telegram account.
# TELEGRAM_BRIDGE_DISABLE_SAVED_MESSAGES=true

# ======================================================================
# Everything below is read only by the Claude bridge (`npm run bridge`).
# The library and `telegram-cli` ignore all of it.
# ======================================================================

# --- Bridge access control (required for `npm run bridge`) ---
# Comma-separated numeric Telegram user IDs. No @, no +. The bridge refuses
# to start when this is missing or empty: there is no "allow everyone".
# TELEGRAM_BRIDGE_ALLOWED_SENDER_IDS=123456789

# --- Bridge paths (optional) ---
# Session-ID persistence file. Default: $HOME/.telegram/claude-bridge.state.json
# TELEGRAM_BRIDGE_STATE_PATH=/Users/me/.telegram/claude-bridge.state.json
# Working directory for the Claude subprocess (its file-access boundary).
# Default: $HOME
# TELEGRAM_BRIDGE_CWD=/Users/me

# --- Voice pipeline (all seven required for `npm run bridge`) ---
# loadVoiceBridgeConfig() runs before any channel starts and throws
# VoiceBridgeConfigError on the first missing value, so the bridge cannot be
# started in a text-only mode. Setup walkthrough:
# docs/design/voice-bridge-setup.md
#
# Path to a GCP service-account key with Speech + TTS access. Deliberately NOT
# named GOOGLE_APPLICATION_CREDENTIALS: the Anthropic Vertex SDK reads that name
# too and would hijack Claude authentication.
# VOICE_BRIDGE_GCP_KEY_PATH=/Users/me/.config/gcloud/voice-bridge-sa.json
# GCP project billed for Speech-to-Text and Text-to-Speech.
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# TTS voice names per language.
# VOICE_BRIDGE_TTS_VOICE_EL=el-GR-Chirp3-HD-Aoede
# VOICE_BRIDGE_TTS_VOICE_EN=en-US-Chirp3-HD-Aoede
# Positive integer. Replies longer than this are sent as full text plus a
# truncated voice note.
# VOICE_BRIDGE_MAX_AUDIO_SECONDS=60
# Positive integer. Inbound voice notes above this are refused.
# VOICE_BRIDGE_REJECT_ABOVE_SECONDS=300
# true|false|1|0|yes|no. Keep inbound and synthesised audio on disk.
# VOICE_BRIDGE_KEEP_AUDIO_FILES=false

# --- Claude provider: Vertex AI (required for `npm run bridge`) ---
# The bridge reads these from THIS file, not from a parent shell profile.
# Region must track the model: >= 4.7 -> eu, <= 4.6 -> europe-west1.
# A stale pin surfaces as "429 quota exceeded".
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=your-vertex-project
# CLOUD_ML_REGION=eu
# ANTHROPIC_MODEL=claude-opus-5[1m]
# Retry tier used on a suspected policy refusal. Change model and region together.
# VERTEX_MODEL_FALLBACK=claude-opus-5[1m]
# VERTEX_REGION_FALLBACK=eu

# --- Claude Code plugin loading (optional) ---
# Comma-separated `name@marketplace` keys. When the allowlist is unset, the
# bridge loads EVERY plugin enabled in ~/.claude/settings.json. Denylist is
# applied after the allowlist.
# BRIDGE_PLUGIN_ALLOWLIST=
# BRIDGE_PLUGIN_DENYLIST=
